# Environment / secrets
.env
application-local.properties

# Runtime config dir — holds the real Atlas URI + secrets, never commit.
# Spring Boot auto-loads ./config/application.properties over the packaged one.
# Must be /config/* not /config/ — git won't descend into an ignored directory,
# so the negation below only works when the contents are ignored, not the dir.
/config/*
!/config/application.properties.example
